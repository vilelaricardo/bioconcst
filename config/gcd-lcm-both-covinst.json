{
  "benchmark": {
    "name": "gcd-lcm-both",
    "path": "./benchmark/message_passing-shared_memory/005_gcd_lcm_both",
    "processes": ["GcdLcmMaster", "GcdLcmSlave", "GcdLcmSlave"],
    "parseFiles": ["GcdLcmMaster.class", "GcdLcmSlave.class", "GcdThread.class", "LcmThread.class"],
    "ignoreFiles": ["HelperClass.class", "Buffer.class"],
    "testSetupProcesses": [
      { "id": 0, "className": "GcdLcmMaster", "args": "2 TESTDATA" },
