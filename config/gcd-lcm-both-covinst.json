    "offspringFraction": 0.7,
    "min": 1,
    "max": 100,
    "threadExecutors": 12,
    "executions": 1
  },
  "strategy": "GA_COVINST",
  "output": {
    "directory": "./results",
    "runName": "gcd-lcm-both-covinst"
  }
