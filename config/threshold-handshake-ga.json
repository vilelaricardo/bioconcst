{
  "benchmark": {
    "name": "threshold-handshake",
    "path": "./benchmark/synthetic/002_threshold_handshake",
    "processes": ["ThresholdHandshake"],
    "parseFiles": ["ThresholdHandshake.class", "Worker.class", "Celebrant.class"],
    "ignoreFiles": ["SharedState.class"],
    "testSetupProcesses": [
      { "id": 0, "className": "ThresholdHandshake", "args": "TESTDATA" }
    ],
    "argumentsLength": 2,
    "argumentRanges": [
      { "min": 0, "max": 1000 },
      { "min": 0, "max": 1000 }
    ]
  },
  "ga": {
    "populationSize": 16,
    "generations": 100,
    "mutationRate": 0.1,
    "crossoverRate": 0.6,
    "survivorsFraction": 0.3,
    "offspringFraction": 0.7,
    "min": 0,
    "max": 100,
    "threadExecutors": 25,
    "executions": 1
  },
  "strategy": "GA",
  "output": {
    "directory": "./results",
    "runName": "threshold-handshake-ga-baseline"
  }
}
