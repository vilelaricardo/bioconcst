{
  "benchmark": {
    "name": "token-ring-iterations",
    "path": "./benchmark/message_passing/008_token_ring_iterations",
    "processes": ["TokenRingMaster", "TokenRingSlave", "TokenRingSlave", "TokenRingSlave"],
    "parseFiles": ["TokenRingMaster.class", "TokenRingSlave.class"],
    "ignoreFiles": ["HelperClass.class"],
    "testSetupProcesses": [
      { "id": 0, "className": "TokenRingMaster", "args": "0 TESTDATA 4" },
      { "id": 1, "className": "TokenRingSlave", "args": "1 TESTDATA 4" },
      { "id": 2, "className": "TokenRingSlave", "args": "2 TESTDATA 4" },
      { "id": 3, "className": "TokenRingSlave", "args": "3 TESTDATA 4" }
    ],
    "argumentsLength": 3,
    "argumentRanges": [
      { "min": 0, "max": 2 },
      { "min": 0, "max": 2 },
      { "min": 1, "max": 11 }
    ],
    "coverageInst": {
      "roleLinks": [
        { "from": "TokenRingMaster", "to": "TokenRingSlave" },
        { "from": "TokenRingSlave", "to": "TokenRingMaster" },
        { "from": "TokenRingSlave", "to": "TokenRingSlave" }
      ],
      "fixedMessageSources": {
        "TokenRingMaster#main:1": [1, 3],
        "1@TokenRingSlave#main:0": [2, 0],
        "2@TokenRingSlave#main:0": [3, 1],
        "3@TokenRingSlave#main:0": [0, 2]
      }
    }
  },
  "ga": {
    "populationSize": 16,
    "generations": 30,
    "mutationRate": 0.1,
    "crossoverRate": 0.6,
    "survivorsFraction": 0.3,
    "offspringFraction": 0.7,
    "min": 0,
    "max": 100,
    "threadExecutors": 4,
    "executions": 1
  },
  "strategy": "GA_COVINST",
  "output": {
    "directory": "./results",
    "runName": "token-ring-iterations-covinst"
  }
}
