{
  "ga": {
    "populationSize": 6,
    "generations": 100,
    "mutationRate": 0.1,
    "crossoverRate": 0.6,
    "survivorsFraction": 0.1,
    "offspringFraction": 0.9,
    "min": 0,
    "max": 100,
    "threadExecutors": 25,
    "executions": 20
  },
  "strategy": "GA",
  "output": {
    "directory": "./results"
  },
  "benchmarks": [
    {
      "name": "gcdmaster",
      "path": "./benchmark/message_passing/005_parallel_gcd",
