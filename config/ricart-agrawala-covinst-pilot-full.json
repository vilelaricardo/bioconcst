{
  "benchmark": {
    "name": "ricart-agrawala",
    "path": "./benchmark/synthetic/008_ricart_agrawala",
    "processes": ["Node", "Node", "Node"],
    "parseFiles": ["Node.class"],
    "ignoreFiles": ["HelperClass.class"],
    "testSetupProcesses": [
      { "id": 1, "className": "Node", "args": "1 3 TESTDATA0" },
      { "id": 2, "className": "Node", "args": "2 3 TESTDATA1" },
      { "id": 3, "className": "Node", "args": "3 3 TESTDATA2" }
    ],
    "argumentsLength": 3,
    "argumentRanges": [
      { "min": 0, "max": 999 },
      { "min": 0, "max": 999 },
      { "min": 0, "max": 999 }
    ],
    "execTimeLimitMs": 30000,
    "coverageInst": {
      "roleLinks": [
        { "from": "Node", "to": "Node" }
      ],
      "fixedMessageSources": {
        "1@Node#main:1": [2, 3], "2@Node#main:1": [1, 3], "3@Node#main:1": [1, 2],
        "1@Node#main:3": [2, 3], "2@Node#main:3": [1, 3], "3@Node#main:3": [1, 2],
        "1@Node#main:5": [2, 3], "2@Node#main:5": [1, 3], "3@Node#main:5": [1, 2],
        "1@Node#main:6": [2, 3], "2@Node#main:6": [1, 3], "3@Node#main:6": [1, 2]
      },
      "fixedMessageTargets": {
        "1@Node#main:7": 2, "2@Node#main:7": 1, "3@Node#main:7": 1,
        "1@Node#main:8": 3, "2@Node#main:8": 3, "3@Node#main:8": 2
      },
      "causalDistance": {
        "Node#main:2": [{ "localBlock": "Node#main:B11", "wantedTaken": false }],
        "Node#main:4": [{ "localBlock": "Node#main:B21", "wantedTaken": false }],
        "Node#main:7": [
          { "localBlock": "Node#main:B11", "wantedTaken": true },
          { "localBlock": "Node#main:B21", "wantedTaken": true }
        ],
        "Node#main:8": [
          { "localBlock": "Node#main:B11", "wantedTaken": true },
          { "localBlock": "Node#main:B21", "wantedTaken": true }
        ]
      }
    }
  },
  "ga": {
    "populationSize": 16,
    "generations": 10,
    "mutationRate": 0.1,
    "crossoverRate": 0.6,
    "survivorsFraction": 0.3,
    "offspringFraction": 0.7,
    "min": 0,
    "max": 999,
    "threadExecutors": 8,
    "executions": 6
  },
  "strategy": "GA_COVINST",
  "output": {
    "directory": "./results",
    "runName": "ricart-agrawala-covinst-pilot-full"
  }
}
