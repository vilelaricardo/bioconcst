{
  "benchmark": {
    "name": "combined-handshake",
    "path": "./benchmark/synthetic/003_combined_handshake",
    "processes": ["Coordinator", "Peer", "Peer"],
    "parseFiles": ["Coordinator.class", "Peer.class", "WindowChecker.class"],
    "ignoreFiles": ["HelperClass.class", "PeerState.class"],
    "testSetupProcesses": [
      { "id": 0, "className": "Coordinator", "args": "" },
      { "id": 1, "className": "Peer", "args": "1 TESTDATA0" },
      { "id": 2, "className": "Peer", "args": "2 TESTDATA1" }
    ],
    "argumentsLength": 2,
    "argumentRanges": [
      { "min": 0, "max": 1000 },
      { "min": 0, "max": 1000 }
    ],
    "coverageInst": {
      "extraClassesByRole": {
        "Peer": ["Peer", "WindowChecker"]
      },
      "roleLinks": [
        { "from": "Peer", "to": "Coordinator" },
        { "from": "Coordinator", "to": "Peer" }
      ],
      "fixedMessageTargets": {
        "Coordinator#main:2": 1,
        "Coordinator#main:3": 2,
        "Coordinator#main:4": 1,
        "Coordinator#main:5": 2
      },
      "causalDistance": {
        "Peer#main:1": [
          { "localBlock": "WindowChecker#run:B1", "wantedTaken": false },
          { "localBlock": "WindowChecker#run:B0", "wantedTaken": false }
        ],
        "Peer#main:2": [
          { "localBlock": "WindowChecker#run:B1", "wantedTaken": true },
          { "localBlock": "WindowChecker#run:B0", "wantedTaken": true }
        ],
        "Coordinator#main:2": [
          { "viaReceiverEdge": "Coordinator#main:0", "targetSenderEdge": "Peer#main:1" },
          { "viaReceiverEdge": "Coordinator#main:1", "targetSenderEdge": "Peer#main:1" }
        ],
        "Coordinator#main:3": [
          { "viaReceiverEdge": "Coordinator#main:0", "targetSenderEdge": "Peer#main:1" },
          { "viaReceiverEdge": "Coordinator#main:1", "targetSenderEdge": "Peer#main:1" }
        ]
      }
    }
  },
  "ga": {
    "populationSize": 16,
    "generations": 20,
    "mutationRate": 0.1,
    "crossoverRate": 0.6,
    "survivorsFraction": 0.3,
    "offspringFraction": 0.7,
    "min": 0,
    "max": 1000,
    "threadExecutors": 12,
    "executions": 6
  },
  "strategy": "GA_COVINST",
  "output": {
    "directory": "./results",
    "runName": "combined-handshake-covinst-pilot-full"
  }
}
