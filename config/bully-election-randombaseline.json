      "Node"
    ],
    "parseFiles": [
      "Node.class"
    ],
    "ignoreFiles": [
      "HelperClass.class"
    ],
    "testSetupProcesses": [
      {
        "id": 1,
        "className": "Node",
        "args": "1 3"
      },
      {
        "id": 2,
        "className": "Node",
        "args": "2 3 TESTDATA0"
      },
      {
        "id": 3,
        "className": "Node",
        "args": "3 3 TESTDATA1"
      }
